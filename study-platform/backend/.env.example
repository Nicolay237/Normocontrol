APP_ENVIRONMENT=development
STUDYPLATFORM_WS_PORT=8000
APP_DATABASE_URL=postgresql+asyncpg://platform:platform@db:5432/platform
APP_DATABASE_NULL_POOL=false
APP_FILES_ROOT=/data/files
APP_MAX_UPLOAD_SIZE=1073741824
APP_MAX_AVATAR_SIZE=524288

APP_WS_ACTIONS_PER_MINUTE=240
APP_MAX_CHAT_MESSAGE_LENGTH=10000
APP_MAX_BLOCK_DATA_SIZE=262144
APP_MAX_PAGE_INPUT_EVENT_BATCH=100
APP_MAX_ATTEMPT_EVENT_BATCH=100
APP_MAX_EVENT_PAYLOAD_SIZE=65536
APP_MAX_IMPORT_RECORDS=50000
APP_ACCESS_TOKEN_TTL_SECONDS=3600
APP_SESSION_TTL_SECONDS=2592000
APP_WS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Git-интеграция лабораторных работ.
# Ключ authenticated encryption для токенов source control: base64 от 32 байт.
# Сгенерировать: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_SOURCE_CONTROL_ENCRYPTION_KEY=
# Куда разрешено возвращать браузер после OAuth callback. Список точных адресов.
APP_SOURCE_CONTROL_OAUTH_RETURN_URLS=["http://localhost:5174/profile"]
# Точный redirect_uri, зарегистрированный в OAuth-приложении. Пусто — берётся
# из входящего запроса, что верно только за прокси с X-Forwarded-*.
APP_SOURCE_CONTROL_OAUTH_CALLBACK_URL=http://localhost:8000/source-control/oauth/callback
APP_SOURCE_CONTROL_OAUTH_STATE_TTL_SECONDS=600
APP_SOURCE_CONTROL_HTTP_TIMEOUT_SECONDS=10
APP_SOURCE_CONTROL_MAX_RESPONSE_BYTES=2097152
APP_SOURCE_CONTROL_MAX_PAGE_SIZE=100
APP_SOURCE_CONTROL_MAX_REDIRECTS=3
# Необязательный bootstrap публичных инстансов. Пусто — заводит администратор.
APP_SOURCE_CONTROL_GITHUB_CLIENT_ID=
APP_SOURCE_CONTROL_GITHUB_CLIENT_SECRET=
APP_SOURCE_CONTROL_GITLAB_CLIENT_ID=
APP_SOURCE_CONTROL_GITLAB_CLIENT_SECRET=

# Нормоконтроль. Проверка живёт во внешнем сервисе — соседний контейнер без
# выхода в сеть, наружу не публикуется. Пусто — материал показывает, что
# проверка недоступна, и файлов не принимает.
APP_NORMOCONTROL_BASE_URL=
APP_NORMOCONTROL_TIMEOUT_SECONDS=180
APP_NORMOCONTROL_MAX_FILE_SIZE=20971520
APP_NORMOCONTROL_MAX_REPORT_BYTES=4194304
APP_NORMOCONTROL_ALLOWED_EXTENSIONS=[".docx",".pdf"]
# Сколько проверок ведём одновременно и по сколько на пользователя.
APP_NORMOCONTROL_CONCURRENCY=2
APP_NORMOCONTROL_USER_CONCURRENCY=1
APP_NORMOCONTROL_USER_QUEUE_LIMIT=5
APP_NORMOCONTROL_POLL_SECONDS=2
APP_NORMOCONTROL_LEASE_SECONDS=600
APP_NORMOCONTROL_MAX_ATTEMPTS=3
