# Сертификаты Let's Encrypt Caddy выпускает и продлевает сам, как только DNS домена
# указывает на этот сервер. Домен берётся из DOMAIN в .env.

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# файлы до 20 МБ (как MAX_CONTENT_LENGTH у приложения) с запасом
	request_body {
		max_size 25MB
	}
	reverse_proxy app:8080
}
