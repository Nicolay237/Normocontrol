# Настройки для docker-compose.yml. Скопируйте в .env и заполните: cp .env.example .env
# Файл .env не попадает в git.

# домен сайта без https:// и www
DOMAIN=normocontrol.site

# пароль базы: любая длинная случайная строка (openssl rand -hex 24)
POSTGRES_PASSWORD=

# подпись cookie сессий (openssl rand -hex 32); смена = все выходят из аккаунтов
SECRET_KEY=

# первый администратор (создаётся, если такого логина ещё нет)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# коды подтверждения из Яндекс Вебмастера и Google Search Console
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=

# цена автоисправления, ₽
AUTOFIX_PRICE=99

# реквизиты для оферты, политики ПД и страницы «Контакты» (нужны для подключения оплаты)
# LEGAL_NAME — ФИО полностью, как в «Мой налог»
LEGAL_NAME=
LEGAL_INN=
CONTACT_EMAIL=
CONTACT_PHONE=
# куда слать письма о сбоях сайта (по умолчанию — CONTACT_EMAIL)
ALERT_EMAIL=

# почта для писем с кодами (подтверждение email, сброс пароля); пока пусто — без подтверждения
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ЮKassa: номер магазина и секретный ключ («Интеграция → Ключи API»); пока пусто — оплата выключена
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
